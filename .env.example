# === ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ ВЛАДЕЛЬЦУ ===

# Telegram
TELEGRAM_BOT_TOKEN=                    # @BotFather → /newbot
TELEGRAM_BOT_USERNAME=enigmapnbot       # без @
# Числовой ID (не @username). Узнать: @userinfobot
ADMIN_TELEGRAM_IDS=

# Домен
DOMAIN=bigwinzone.ru
SUB_DOMAIN=sub.bigwinzone.ru
API_DOMAIN=api.bigwinzone.ru
WEB_DOMAIN=bigwinzone.ru

# База данных
POSTGRES_USER=enigma
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=enigma_pn
DATABASE_URL=postgresql+asyncpg://enigma:change_me_strong_password@postgres:5432/enigma_pn

# Redis
REDIS_URL=redis://redis:6379/0

# JWT / Secrets
SECRET_KEY=                            # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Marzban (после установки панели)
# На одном VPS Marzban слушает 127.0.0.1:8000 — из Docker:
# MARZBAN_URL=http://host.docker.internal:8000
MARZBAN_URL=http://host.docker.internal:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=
# Наш proxy — НЕ прямой URL Marzban
MARZBAN_SUBSCRIPTION_PREFIX=https://sub.bigwinzone.ru:8443/s
# true = mock без реальной панели (для локальной разработки)
MARZBAN_MOCK=true

# VPN Nodes (JSON)
VPN_NODES=[{"id":"nl-1","name":"🇳🇱 Netherlands","weight":100}]

# === YooMoney (HTTP-уведомления) ===
# Номер кошелька (например 410011xxxxxxx)
YOOMONEY_WALLET=
# Секрет для проверки уведомлений (Настройки → HTTP-уведомления)
YOOMONEY_NOTIFICATION_SECRET=
# URL уведомлений (указать в кабинете YooMoney):
# https://api.bigwinzone.ru/webhooks/yoomoney

# Бизнес-настройки
TRIAL_ENABLED=true
TRIAL_DURATION_DAYS=1
TRIAL_TRAFFIC_GB=5
TRIAL_DEVICE_LIMIT=1
DEFAULT_DEVICE_LIMIT=2

# Happ
HAPP_PROVIDER_ID=
HAPP_PROFILE_TITLE=Enigma_PN

# SOCKS5 Telegram proxy (per-account login/password in DB → /opt/socks5/passwd)
SOCKS5_ENABLED=false
SOCKS5_HOST=bigwinzone.ru
SOCKS5_PORT=40080
SOCKS5_PASSWD_PATH=/opt/socks5/passwd
SOCKS5_CONTAINER=socks5

# Брендинг
BRAND_NAME=Enigma_PN
SUPPORT_TELEGRAM=@alexkr1t

# Internal API URL (для бота внутри Docker)
API_INTERNAL_URL=http://api:8000
BOT_API_TOKEN=                         # openssl rand -hex 24 — shared secret bot↔api

# Web admin panel — https://bigwinzone.ru:1110/admin
ADMIN_WEB_USERNAME=
ADMIN_WEB_PASSWORD=
ADMIN_WEB_JWT_EXPIRE_MINUTES=720
