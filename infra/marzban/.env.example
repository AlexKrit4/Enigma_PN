# Example Marzban .env (install separately on panel VPS)
# Docs: https://github.com/Gozargah/Marzban

UVICORN_PORT=8000
SUDO_USERNAME=admin
SUDO_PASSWORD=CHANGE_ME
XRAY_JSON=/var/lib/marzban/xray_config.json
SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3
# After install set MARZBAN_URL / USERNAME / PASSWORD in Enigma_PN .env
# and MARZBAN_MOCK=false
